  setTimeout(()=>{closeAuth(); pay(plan, plan==='Basic'?10:plan==='Premium'?100:plan==='Gold'?500:1000)},600);
  updateStatus();
}
function doLogin(){
  const email=document.getElementById('loginEmail').value;
  if(!email){alert('Enter email');return;}
  if(user && user.email===email){document.getElementById('authMsg').innerText='Welcome back '+user.name; setTimeout(closeAuth,600);}
  else{user={name:email.split('@')[0],email,plan:'Basic'}; localStorage.setItem('sl_user',JSON.stringify(user)); document.getElementById('authMsg').innerText='Logged in as new user - Basic'; setTimeout(closeAuth,600);}
  updateStatus();
}
function logout(){localStorage.removeItem('sl_user'); user=null; updateStatus(); location.reload();}
function pay(plan,amount){currentPlan=plan; currentAmount=amount; document.getElementById('payTitle').innerText='Pay '+amount+' Bob - '+plan+' Plan'; document.getElementById('payAmount').innerText=amount+' Bob'; document.getElementById('payModal').classList.add('open');}
function closePay(){document.getElementById('payModal').classList.remove('open');}
function confirmPay(){
  if(!user) user={name:'Guest',email:'guest',plan:currentPlan};
  user.plan=currentPlan; localStorage.setItem('sl_user',JSON.stringify(user));
  alert('✅ Payment Confirmed! Your '+currentPlan+' plan is now ACTIVE. Welcome! Send proof to 0757909738 on WhatsApp');
  closePay(); updateStatus();
}
function needPlan(need){
  if(!user){openAuth(); return;}
  const levels={Basic:1,Premium:2,Gold:3,Ring:4};
  if(levels[user.plan]>=levels[need]) alert('✅ You have access! Opening lesson...');
  else alert('🔒 This needs '+need+' plan. You have '+user.plan+'. Please upgrade!');
}
function sendChat(){
  if(!user){openAuth(); return;}
  if(user.plan==='Basic'){document.getElementById('chatLock').innerText='🔒 Chat needs Premium+. Upgrade to chat.'; return;}
  const v=document.getElementById('chatInput').value; if(!v) return;
  document.getElementById('msgs').innerHTML+=`<div class="msg"><b>${user.name} (${user.plan}):</b> ${v}</div>`;
  document.getElementById('chatInput').value='';
}
function joinVideo(){
